# ─────────────────────────────────────────────────────────────
#  Copy this file to `.env` and fill it in. Never commit `.env`.
# ─────────────────────────────────────────────────────────────

# Bot token from https://discord.com/developers/applications → Bot → Reset Token.
# NOTE: this must be a BOT token. A personal user token will not work here and
# automating one is against Discord's Terms of Service.
DISCORD_TOKEN=

# Your server (guild) id. Right-click the server → Copy Server ID
# (enable Developer Mode in Discord settings first).
GUILD_ID=

# Optional — paste these after running `/setup` or `npm run setup` so the bot
# stops looking roles/channels up by name.
STAFF_ROLE_ID=
MANAGER_ROLE_ID=
LOG_CHANNEL_ID=
TRANSCRIPT_CHANNEL_ID=

# ── Brand ────────────────────────────────────────────────────
# Server name + shop icon, used on every panel, embed and transcript.
BRAND_NAME=Le Comptoir des Kamas
BRAND_EMOJI=🏪
# The bot's display name. Discord bot usernames are globally unique, so set the
# exact same name in the dev portal (Bot → Username) or the two will disagree.
BRAND_BOT_NAME=Commis
BRAND_WEBSITE=https://example.com

# ── Behaviour ────────────────────────────────────────────────
# Staff role looked up by name when STAFF_ROLE_ID is empty.
STAFF_ROLE_NAME=Staff
# What happens when a ticket is closed: "delete" or "archive".
TICKET_CLOSE_ACTION=delete
# Open tickets per user per type (1 = one at a time).
MAX_OPEN_TICKETS_PER_USER=1
# Delay in ms between channel/role creations during /setup (rate-limit safety).
SETUP_STEP_DELAY_MS=1500

# ── Hosting ──────────────────────────────────────────────────
# Hosts like Render set PORT themselves; the bot then serves /healthz and a JSON
# status on / (see src/health.js). Leave empty when running locally.
PORT=

# Optional — where data/*.json live. Point it at a mounted disk when your host
# has one; on free plans the filesystem is wiped on every redeploy.
# DATA_DIR=/var/data

# ── State mirror (see src/persist.js) ────────────────────────
# Discord keeps messages forever and for free, so the bot stores a JSON snapshot
# of data/ as an attachment in « ⚙️・gestion » and re-imports it at boot. That is
# what makes a free host (no persistent disk) viable.
#   on / off
STATE_MIRROR=on
# What to do at startup with the online snapshot:
#   when-empty → only import if the local data/ is blank (safe default)
#   always     → always trust the snapshot (recommended on free hosts)
#   off        → never import
STATE_IMPORT=when-empty
# Channel holding the snapshot; resolved by name (⚙️・gestion) when empty.
STATE_CHANNEL_ID=

# ── Prix automatiques (see src/price-feed.js) ─────────────────
# Reads market prices from kamasv.com and 1kamas.com (public WooCommerce API).
#   on / off
PRICE_FEED=on
# Minutes between two reads (minimum 10).
PRICE_FEED_INTERVAL_MIN=30
# Optional HTTP proxy for sites that block the host's IP: http://user:pass@host:port
# Secret — set it in .env / the Render dashboard only, never commit it.
PRICE_FEED_PROXY=
#   fallback → direct first, proxy only for a site that blocks us (default, saves proxy bandwidth)
#   always   → every price request through the proxy
PRICE_FEED_PROXY_MODE=fallback
